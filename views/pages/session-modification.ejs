<!DOCTYPE html>
<html>
	<%- include('../partials/_head.ejs') %>

	<body>
		<div class="wrapper">
			<%- include('../partials/_header.ejs') %>

			<main class="main">
				<div class="section-main session-modification">
                    <div class="content-wrapper session-modification-form__wrapper">
						<div class="session-modification-form__content">
							<h1 class="section-main__title">Session <span class="darker-text-higlight"><%= session.personId %></span></h1>
							<div class="form__container">
								<form
									action="/session/modify/<%= session.personId %>"
									method="post"
									class="form modification-form"
								>
									<div class="form__section">
										<div class="form__section-block">
											<div class="form__block">
												<label for="">Person Name</label>
												<input
													type="text"
													name="name"
													value="<%= session.name %>"
													placeholder="Ray Blackwood"
												/>
											</div>

											<div class="form__block">
												<label for="">Training Date</label>
												<input
													type="text" 
													name="trainingDate"
													value="<%= session.date %>"
													placeholder="dd / mm / yyyy"
												/>
											</div>
										</div>
									</div>
									<div class="session-modification-content__button-block">
										<a href="/session/list" class="button">Go Back</a>
										<button type="submit" class="button">Modify</button>
									</div>

								</form>
							</div>
						</div>
				</div>
			</main>

			<%- include('../partials/_footer.ejs') %>
		</div>
		<script src="/javascripts/navigation.js"></script>
	</body>
</html>
